{
  "appId": "com.finalalpha.finaleffect3d",
  "appName": "Final Effect 3D",
  "webDir": "build/client",
  "bundledWebRuntime": false,
  "backgroundColor": "#0d0e12",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d0e12",
      "overlaysWebView": true
    }
  }
}
